<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_weather_name"
        android:scaleType="fitXY" />

    <!-- padded at runtime so the clock sits exactly inside the tile drawn in the bitmap -->
    <FrameLayout
        android:id="@+id/clock_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/clock_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/btn_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_press_clock"
            android:contentDescription="Time" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/date_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/btn_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_press_round"
            android:contentDescription="Date" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/icon_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/btn_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_press_round"
            android:contentDescription="Update weather" />
    </FrameLayout>
</FrameLayout>
